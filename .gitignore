.godot/
.import/
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.tmp
*.temp
*.log
build/*
!build/.gdignore
dist/
exports/
.env
.env.*
!.env.example

# Per-user AI/editor bridge configuration. Use the tracked template under
# addons/godot_mcp_toolkit/ when local MCP tooling is intentionally enabled.
.mcp.json

# Godot import metadata for README-only media is generated locally.
docs/media/*.import

# The uncompressed WAV master of the procedural music loop is a regenerable
# build artifact (`tools/generate_audio.py`); only the Ogg Vorbis encode ships.
audio/music/*.wav
audio/music/*.wav.import
__pycache__/
