# -*- mode: python ; coding: utf-8 -*-
# Build with: python tools/build_launcher.py
# datas bundles the launcher's artwork (generated by tools/studio_brand.py) under assets/ inside the exe, where
# launcher.py's _asset_path looks for it (sys._MEIPASS/assets). An empty datas list is what made the frozen
# launcher lose its logo and fall back to plain text, so build_launcher.py now also checks the built exe.

a = Analysis(
    ['launcher/__main__.py'],
    pathex=[],
    binaries=[],
    datas=[
        ('launcher/assets/wordmark.png', 'assets'),
        ('launcher/assets/studio.png', 'assets'),
        ('launcher/assets/rocket.png', 'assets'),
        ('launcher/assets/icon.ico', 'assets'),
    ],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='ProjectAscentLauncher',
    icon='launcher/assets/icon.ico',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,          # UPX-packed executables are flagged by antivirus far more often
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
