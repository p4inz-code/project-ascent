class_name MachineProbe
extends RefCounted
## Finds, by sweeping the simulated physics, the NOMINAL PLAN for a piece (when to jump, how long to
## hold, when to start across a flame, where to stand in a jet) and how WIDE the window of correct
## plans is. The window width against human timing error gives the piece's pass probability q:
##
##     q = erf( half_window / (sigma * sqrt 2) )
##
## where the half window is in the same unit as the sigma (pixels for jumps, seconds for flames,
## pixels for jets). Nothing here is a guess about difficulty: a narrow window is read off the real
## movement numbers.
##
## Results are cached per piece SIGNATURE (kind, size, belt), so a level roll costs table lookups,
## not sweeps. tools/gen_machine_table.gd writes the cache to scripts/machine_table_data.gd, and
## tests/test_machine_pieces.gd re-derives a sample of it to prove the file is not stale.

const TABLE_SCRIPT := "res://scripts/machine_table_data.gd"
const PROBE_X0 := 700.0

## The timing sigmas (seconds) the table records a measured pass probability for: expert, median, novice.
const Q_SIGMAS := [0.020, 0.040, 0.060]
const Q_SAMPLES := 400

static var _cache: Dictionary = {}
static var _loaded: bool = false
static var use_table_file: bool = true
## How many sweep runs this process executed (tests assert the table avoids them).
static var sweeps_run: int = 0


## The cache key. Absolute position and flame phase do not matter, so they are left out.
static func key_of(piece: Dictionary, belt: Variant) -> String:
	var k: String = String(piece["k"])
	var b := "b0"
	if belt != null:
		b = "b%d" % int(float(belt["dir"]) * float(belt["speed"]))
	var parts: Array = [k, String(piece.get("lane", "L")), b]
	if piece.has("surface"):
		parts.append("s-" + String(piece["surface"]))
	match k:
		"spikes":
			parts.append("w%d" % int(piece["w"]))
		"hump":
			parts.append("w%d" % int(piece["w"]))
			parts.append("h%d" % int(piece["h"]))
		"pit", "gap":
			parts.append("w%d" % int(piece["w"]))
		"flame", "crusher", "hail":
			parts.append("w%d" % int(piece["w"]))
			parts.append("p%d" % int(round(float(piece["period"]) * 100.0)))
			parts.append("a%d" % int(round(float(piece["active"]) * 100.0)))
		"jet":
			parts.append("w%d" % int(piece["w"]))
		"rspike_gap":
			parts.append("w%d" % int(piece["w"]))
			parts.append("l%d" % int(piece["len"]))
	return "|".join(parts)


static func _ensure_loaded() -> void:
	if _loaded:
		return
	_loaded = true
	if not use_table_file:
		return
	var data = load(TABLE_SCRIPT)
	if data != null and "TABLE" in data:
		_cache = (data.TABLE as Dictionary).duplicate(true)


static func table() -> Dictionary:
	_ensure_loaded()
	return _cache


## Write the cache as scripts/machine_table_data.gd (a script, not a .json, so it always ships in an
## export). `path` is a filesystem or res:// path.
static func save_table(path: String = TABLE_SCRIPT) -> bool:
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		return false
	f.store_string("class_name MachineTableData
extends RefCounted
## GENERATED by tools/gen_machine_table.gd from the real physics. Do not edit.

")
	f.store_string("const TABLE := " + JSON.stringify(_cache, "	", true) + "
")
	return true


static func clear_cache() -> void:
	_cache.clear()
	_loaded = true


## The plan for a piece: from the cache, else by sweeping.
static func plan_for(piece: Dictionary, belt: Variant = null) -> Dictionary:
	_ensure_loaded()
	var k := key_of(piece, belt)
	if _cache.has(k):
		return _cache[k]
	var plan := sweep(piece, belt)
	if float(plan.get("half", 0.0)) > 0.0:
		var qs: Dictionary = {}
		for sg in Q_SIGMAS:
			qs[str(int(round(sg * 1000.0)))] = measure_q(piece, belt, plan, sg, Q_SAMPLES)
		plan["q"] = qs
	_cache[k] = plan
	return plan


# --- sweeps --------------------------------------------------------------------------

## A tiny world with the piece in the middle and calm cells either side.
static func probe_spec(piece: Dictionary, belt: Variant) -> Dictionary:
	var lane: String = String(piece.get("lane", "L"))
	var cx0 := PROBE_X0
	var cx1 := PROBE_X0 + MachinePieces.CELL_W
	var cx2 := PROBE_X0 + 2.0 * MachinePieces.CELL_W
	var p: Dictionary = piece.duplicate()
	p["lane"] = lane
	var off := 220.0
	match String(p["k"]):
		"jet":
			p["x"] = cx1 + 230.0
			p["hole_x"] = float(p["x"]) - 25.0
			p["hole_w"] = MachinePieces.HOLE_W
		"rspike_gap":
			p["x"] = cx1 + off
			p["sx"] = float(p["x"]) - 20.0
			p["sw"] = float(p["w"]) + 40.0
		_:
			p["x"] = cx1 + off
	var deck_everywhere := lane == "U" or String(p["k"]) == "jet"
	var c0 := {"x": cx0, "L": {"k": "plain"}, "U": ({"k": "deck"} if deck_everywhere else {"k": "none"})}
	var c1 := {"x": cx1, "belt": belt}
	if piece.has("surface"):
		c1["surface"] = String(piece["surface"])
	var c2 := {"x": cx2, "L": {"k": "plain"}, "U": ({"k": "deck"} if deck_everywhere else {"k": "none"})}
	if lane == "L":
		c1["L"] = p
		c1["U"] = {"k": "none"}
	else:
		c1["L"] = {"k": "plain"}
		c1["U"] = p
	if String(p["k"]) == "jet":
		c1["L"] = p
		c1["U"] = {"k": "deck"}
	return {"cells": [c0, c1, c2], "end_x": cx2 + MachinePieces.CELL_W}


## Run one noiseless pass of the probe world with a plan override. Returns true when it clears the
## piece cleanly (alive, no chip hit, on the right lane at the end).
static func trial(spec: Dictionary, piece: Dictionary, plan: Dictionary) -> Dictionary:
	sweeps_run += 1
	var world := MachinePieces.build_world(spec)
	var lane: String = String(piece.get("lane", "L"))
	var start_lane := "U" if lane == "U" else "L"
	var route: Array = [start_lane, start_lane, start_lane]
	var events := MachineBot.events_for(spec, route, start_lane)
	# Only the middle cell's event matters; drop anything else.
	var evs: Array = []
	for e in events:
		if int(e["cell"]) == 1:
			evs.append(e)
	var start_y := MachinePieces.FLOOR_Y - MachineSim.HALF.y - 0.01
	if start_lane == "U":
		start_y = MachinePieces.DECK_Y - MachineSim.HALF.y - 0.01
	var goal_x: float = float(spec["end_x"]) - 120.0
	var bot := MachineBot.new(world, evs, Vector2(PROBE_X0 + 140.0, start_y), goal_x, 0.0)
	bot.override_plan = plan
	bot.override_kind = String(piece["k"])
	var res := bot.run(30.0)
	var feet := bot.sim.pos.y + MachineSim.HALF.y
	var final_lane_ok := true
	if lane == "U" or String(piece["k"]) == "jet":
		final_lane_ok = absf(feet - MachinePieces.DECK_Y) < 6.0
	else:
		final_lane_ok = absf(feet - MachinePieces.FLOOR_Y) < 6.0
	res["clean"] = bool(res["finished"]) and int(res["hits"]) == 0 and final_lane_ok
	res["passed"] = bool(res["finished"]) and final_lane_ok
	return res


## Longest contiguous run of true in `flags` (indexed 0..n-1). Returns [lo, hi] indices or [-1, -1].
static func _longest_run(flags: Array) -> Array:
	var best := [-1, -1]
	var start := -1
	for i in flags.size() + 1:
		var on: bool = i < flags.size() and bool(flags[i])
		if on and start < 0:
			start = i
		if (not on) and start >= 0:
			if best[0] < 0 or (i - 1 - start) > (best[1] - best[0]):
				best = [start, i - 1]
			start = -1
	return best


static func sweep(piece: Dictionary, belt: Variant) -> Dictionary:
	var k := String(piece["k"])
	var spec := probe_spec(piece, belt)
	var p: Dictionary = (spec["cells"][1]["L"] if (String(piece.get("lane", "L")) == "L" or k == "jet") else spec["cells"][1]["U"])
	var plan: Dictionary = {"k": k}
	match k:
		"spikes", "hump", "pit", "gap":
			# A full jump is held well past the minimum so a release-timing error cannot shorten it.
			return _sweep_jump(spec, p, plan, [30])
		"rspike_gap":
			return _sweep_jump(spec, p, plan, [4, 5, 6, 7, 8, 9, 10, 12, 14])
		"flame", "crusher", "hail":
			return _sweep_flame(spec, p, plan)
		"jet":
			return _sweep_jet(spec, p, plan)
	plan["half"] = 0.0
	return plan


static func _sweep_jump(spec: Dictionary, p: Dictionary, plan: Dictionary, holds: Array) -> Dictionary:
	# 1. For each candidate hold length, the window of takeoff positions that clears the piece.
	var windows: Dictionary = {}
	var max_half := -1.0
	for h in holds:
		var flags: Array = []
		var leads: Array = []
		for lead in range(-40, 261, 2):
			var r := trial(spec, p, {"lead": float(lead), "hold": float(h)})
			flags.append(bool(r["clean"]))
			leads.append(lead)
		var run := _longest_run(flags)
		if run[0] < 0:
			continue
		var lo: float = leads[run[0]]
		var hi: float = leads[run[1]]
		var half := (hi - lo) * 0.5 + 1.0
		windows[h] = {"lead": (lo + hi) * 0.5, "lo": lo, "hi": hi, "half": half}
		max_half = maxf(max_half, half)
	if windows.is_empty():
		plan["half"] = 0.0
		plan["lead"] = 0.0
		plan["hold"] = 22.0
		return plan
	# 2. The hold to aim for: the middle of the holds that keep most of the best window, so a
	#    timing error in the release is as likely to land short of it as long.
	var good: Array = []
	for h in windows:
		if float(windows[h]["half"]) >= 0.6 * max_half:
			good.append(h)
	good.sort()
	var chosen: int = good[0]
	if holds.size() > 1:
		var total := 0.0
		for h in good:
			total += float(h)
		var target_hold := total / float(good.size())
		var best_d := 1e9
		for h in good:
			if absf(float(h) - target_hold) < best_d:
				best_d = absf(float(h) - target_hold)
				chosen = h
	plan.merge(windows[chosen], true)
	plan["hold"] = float(chosen)
	# 3. How many frames either way the release can slip at that takeoff.
	var hflags: Array = []
	var hvals: Array = []
	for hh in range(2, 40):
		var r2 := trial(spec, p, {"lead": float(plan["lead"]), "hold": float(hh)})
		hflags.append(bool(r2["clean"]))
		hvals.append(hh)
	var hrun := _longest_run(hflags)
	var hlo := float(chosen)
	var hhi := float(chosen)
	if hrun[0] >= 0:
		hlo = hvals[hrun[0]]
		hhi = hvals[hrun[1]]
	plan["hold_lo"] = hlo
	plan["hold_hi"] = hhi
	return plan


static func _sweep_flame(spec: Dictionary, p: Dictionary, plan: Dictionary) -> Dictionary:
	var period: float = float(p["period"])
	var best_half := -1.0
	var best: Dictionary = {}
	# A person stops well short of the flame (a stop overshoots by about 10 px): take the better stand.
	# A delta only counts when it is clean at several arrival phases of the flame's cycle.
	var phases := [0.0, period * 0.37, period * 0.71]
	for stand in [70.0, 40.0]:
		var flags: Array = []
		var deltas: Array = []
		var d := -1.4
		while d <= period:
			var ok_all := true
			for ph in phases:
				p["phase"] = ph
				var r := trial(spec, p, {"delta": d, "stand": stand})
				if not bool(r["clean"]):
					ok_all = false
					break
			flags.append(ok_all)
			deltas.append(d)
			d += 0.02
		p["phase"] = 0.0
		var run := _longest_run(flags)
		if run[0] < 0:
			continue
		var lo: float = deltas[run[0]]
		var hi: float = deltas[run[1]]
		var half := (hi - lo) * 0.5 + 0.01
		if half > best_half:
			best_half = half
			best = {"delta": (lo + hi) * 0.5, "stand": stand, "lo": lo, "hi": hi, "half": half}
	if best.is_empty():
		plan["half"] = 0.0
		plan["delta"] = 0.0
		plan["stand"] = 70.0
		return plan
	plan.merge(best, true)
	return plan


static func _sweep_jet(spec: Dictionary, p: Dictionary, plan: Dictionary) -> Dictionary:
	var flags: Array = []
	var offs: Array = []
	for off in range(-75, 76, 1):
		var r := trial(spec, p, {"offset": float(off)})
		flags.append(bool(r["passed"]))
		offs.append(off)
	var run := _longest_run(flags)
	if run[0] < 0:
		plan["half"] = 0.0
		plan["offset"] = 0.0
		return plan
	var lo: float = offs[run[0]]
	var hi: float = offs[run[1]]
	plan.merge({"offset": (lo + hi) * 0.5, "lo": lo, "hi": hi, "half": (hi - lo) * 0.5 + 0.5}, true)
	return plan


# --- probabilities --------------------------------------------------------------------

## erf approximation (Abramowitz-Stegun 7.1.26), good to 1.5e-7.
static func erf(x: float) -> float:
	var s := 1.0 if x >= 0.0 else -1.0
	var ax := absf(x)
	var t := 1.0 / (1.0 + 0.3275911 * ax)
	var y := 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-ax * ax)
	return s * y


## How a failure of this kind of piece is paid for: "chip" (one cell), "kill" (instant) or "free"
## (only costs time: a bump or a missed lift can simply be retried).
static func risk_class(kind: String) -> String:
	match kind:
		"spikes", "flame", "hail":
			return "chip"
		"pit", "gap", "rspike_gap", "furnace", "crusher":
			return "kill"
	return "free"


## The measured chance that the NOISY bot (the real executor, with all its error sources) clears this
## piece cleanly: no hit, alive, on the right lane. Seeded, so the table is reproducible.
static func measure_q(piece: Dictionary, belt: Variant, plan: Dictionary, sigma_t: float, samples: int) -> float:
	sweeps_run += 1
	var spec := probe_spec(piece, belt)
	var lane: String = String(piece.get("lane", "L"))
	var k := String(piece["k"])
	var start_lane := "U" if lane == "U" else "L"
	var events: Array = []
	for e in MachineBot.events_for(spec, [start_lane, start_lane, start_lane], start_lane):
		if int(e["cell"]) == 1:
			events.append(e)
	var world := MachinePieces.build_world(spec)
	var start_y := (MachinePieces.DECK_Y if start_lane == "U" else MachinePieces.FLOOR_Y) - MachineSim.HALF.y - 0.01
	var goal_x: float = float(spec["end_x"]) - 120.0
	var wins := 0
	for i in samples:
		var rng := RandomNumberGenerator.new()
		rng.seed = 424242 + i * 7919 + int(sigma_t * 100000.0)
		var bot := MachineBot.new(world, events.duplicate(true), Vector2(PROBE_X0 + 140.0, start_y), goal_x, sigma_t, rng)
		bot.override_plan = plan
		bot.override_kind = k
		var res := bot.run(30.0)
		var feet := bot.sim.pos.y + MachineSim.HALF.y
		var want := MachinePieces.DECK_Y if (lane == "U" or k == "jet") else MachinePieces.FLOOR_Y
		if bool(res["finished"]) and int(res["hits"]) == 0 and absf(feet - want) < 6.0:
			wins += 1
	return float(wins) / float(samples)


## The total width of a piece's window in frames at the speed the player actually crosses it (belts
## change that speed). Flames are measured in time already. Used to keep every piece out of
## frame-perfect territory.
static func window_frames(piece: Dictionary, belt: Variant) -> float:
	var plan := plan_for(piece, belt)
	var half: float = float(plan.get("half", 0.0))
	if String(piece["k"]) in ["flame", "crusher", "hail"]:
		return half * 2.0 * 60.0
	var bspeed: float = 0.0 if belt == null else float(belt["dir"]) * float(belt["speed"])
	var v := maxf(absf(MachineSim.MAX_SPEED + bspeed), 60.0)
	return half * 2.0 / v * 60.0


## Standard normal CDF.
static func cdf(x: float) -> float:
	return 0.5 * (1.0 + erf(x / sqrt(2.0)))


## The chance the release lands inside the plan's hold window, given the sigma of the timing error
## (in frames). A full hold has plenty of slack above its minimum, a tap does not.
static func _hold_probability(plan: Dictionary, sigma_t: float) -> float:
	var nominal: float = float(plan.get("hold", 22.0))
	var lo: float = float(plan.get("hold_lo", nominal)) - 0.5
	var hi: float = float(plan.get("hold_hi", nominal)) + 0.5
	var sh := maxf(sigma_t * 60.0, 0.01)
	return clampf(cdf((hi - nominal) / sh) - cdf((lo - nominal) / sh), 0.0, 1.0)


## Probability that a player with timing sigma `sigma_t` (seconds) clears this piece cleanly.
static func q_piece(piece: Dictionary, belt: Variant, sigma_t: float) -> float:
	var plan := plan_for(piece, belt)
	var half: float = float(plan.get("half", 0.0))
	if half <= 0.0:
		return 0.0
	if plan.has("q"):
		return _q_from_measured(plan["q"], sigma_t)
	var k := String(piece["k"])
	var bspeed: float = 0.0 if belt == null else float(belt["dir"]) * float(belt["speed"])
	match k:
		"spikes", "hump", "pit", "gap", "rspike_gap":
			var sx := MachineBot.ground_sigma_px(sigma_t, bspeed)
			var qx := erf(half / (sx * sqrt(2.0)))
			return qx * _hold_probability(plan, sigma_t)
		"flame", "crusher", "hail":
			return erf(half / (maxf(sigma_t, 0.001) * sqrt(2.0)))
		"jet":
			var sp := sigma_t * MachineSim.MAX_SPEED * 0.8
			return erf(half / (maxf(sp, 0.5) * sqrt(2.0)))
	return 1.0


## Interpolate the measured q between the recorded sigmas: linear in log(-log q) against log sigma,
## which is how a Gaussian error tail behaves; clamps to the end values outside the recorded range.
static func _q_from_measured(qs: Dictionary, sigma_t: float) -> float:
	var nodes: Array = []
	for sg in Q_SIGMAS:
		var key := str(int(round(sg * 1000.0)))
		nodes.append([sg, clampf(float(qs.get(key, 1.0)), 0.0005, 1.0)])
	if sigma_t <= float(nodes[0][0]):
		return float(nodes[0][1]) if sigma_t >= float(nodes[0][0]) else _extrapolate(nodes[0], nodes[1], sigma_t)
	for i in range(1, nodes.size()):
		if sigma_t <= float(nodes[i][0]):
			return _extrapolate(nodes[i - 1], nodes[i], sigma_t)
	return _extrapolate(nodes[nodes.size() - 2], nodes[nodes.size() - 1], sigma_t)


static func _extrapolate(a: Array, b: Array, sigma_t: float) -> float:
	var qa := float(a[1])
	var qb := float(b[1])
	if qa >= 0.9995 and qb >= 0.9995:
		return 1.0
	# failure rate f = 1 - q grows with sigma: interpolate log f linearly in log sigma
	var fa := maxf(1.0 - qa, 1e-4)
	var fb := maxf(1.0 - qb, 1e-4)
	var t := (log(maxf(sigma_t, 1e-4)) - log(float(a[0]))) / (log(float(b[0])) - log(float(a[0])))
	var f := exp(log(fa) + (log(fb) - log(fa)) * t)
	return clampf(1.0 - f, 0.0, 1.0)


## Level pass probability for a list of events (as MachineBot.events_for builds): the chance of
## reaching the end alive. Kill pieces end the run when failed; chip pieces cost a cell and the
## third cell is death. Free pieces never fail the run.
static func level_pass_probability(events: Array, sigma_t: float, max_hits: int = 2) -> float:
	var dp: Array = []
	for i in max_hits + 1:
		dp.append(0.0)
	dp[0] = 1.0
	for ev in events:
		var piece: Dictionary = ev["piece"]
		var cls := risk_class(String(ev["kind"]) if ev["kind"] != "drop" else "free")
		if cls == "free":
			continue
		var q := q_piece(piece, ev.get("belt"), sigma_t)
		if cls == "kill":
			for i in dp.size():
				dp[i] = dp[i] * q
		else:
			var nd: Array = []
			for i in dp.size():
				nd.append(0.0)
			for i in dp.size():
				nd[i] += dp[i] * q
				if i + 1 < dp.size():
					nd[i + 1] += dp[i] * (1.0 - q)
			dp = nd
	var total := 0.0
	for v in dp:
		total += float(v)
	return total
